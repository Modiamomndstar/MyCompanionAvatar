# ── Server & Security ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-strong-64-char-random-secret
CORS_ORIGIN=http://localhost:3000
OWNER_EMAIL=admin@example.com

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3307/chatcompanion

# ── AI Providers ────────────────────────────────────────────────
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
REPLICATE_API_TOKEN=

# ── Object Storage (S3 / Cloudflare R2) ─────────────────────────
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Payments (Web) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# ── Frontend (Vite) ─────────────────────────────────────────────
# Leave empty when frontend and API share the same origin.
# Set to https://api.yourdomain.com for standalone web or mobile builds.
VITE_API_URL=
